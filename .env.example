# Site
NEXT_PUBLIC_SITE_URL=
NEXT_PUBLIC_SCHEDULE_URL=
# Example: https://calendly.com/pmackiniv27/medicare-advantage-consultation
NEXT_PUBLIC_FORMSUBMIT_TO=
FORMSUBMIT_TO=

# Google Business Profile review routing.
# Use the direct "Ask for reviews" link from GBP when available, for example:
# https://g.page/r/EXAMPLE_REVIEW_ID/review
GOOGLE_BUSINESS_PROFILE_REVIEW_URL=
GOOGLE_BUSINESS_PROFILE_URL=

# SMTP (lead + handoff email)
SMTP_HOST=
SMTP_PORT=
SMTP_SECURE=
SMTP_USER=
SMTP_PASS=

# Lead notifications — set OWNER_EMAIL in Vercel Production so you receive form/callback emails
OWNER_EMAIL=
OWNER_PHONE=
LEAD_SMS_DISABLED=

# Twilio (optional; lead SMS)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_MESSAGING_SERVICE_SID=

# Notion CRM — see docs/NOTION_CRM_INTEGRATION.md
NOTION_API_KEY=
NOTION_DATABASE_ID=

# Lead webhook (optional; Zapier/Make/n8n)
LEAD_WEBHOOK_URL=

# Agent Builder — API key for /api/drafts and /api/handoff (Bearer or x-api-key)
AGENT_API_KEY=

# Drafts webhook (optional; receive draft payloads from Agent Builder)
DRAFTS_WEBHOOK_URL=

# Admin — optional; if set, GET /api/admin/events requires ?key=ADMIN_SECRET or x-admin-key
ADMIN_SECRET=

# OpenAI (optional; AI chat)
OPENAI_API_KEY=
